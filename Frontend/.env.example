# Домен для canonical и Open Graph. По умолчанию https://tiglev.com.
# На превью-деплоях Vercel обязательно свой: иначе canonical укажет на прод.
NEXT_PUBLIC_SITE_URL=
# Мессенджеры для связи с клиентом со страницы автомобиля.
# Ник без «@»; незаполненный мессенджер просто не показывается на сайте.
# VK по умолчанию берётся тот, что уже опубликован в подвале (vk.com/tiglev).
NEXT_PUBLIC_TELEGRAM_USERNAME=
NEXT_PUBLIC_MAX_USERNAME=
NEXT_PUBLIC_VK_USERNAME=
